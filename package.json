{
  "name": "@beautifulbits/lib",
  "version": "2.0.0",
  "description": "Shared code manager",
  "main": "./build/index.js",
  "bin": "./build/exec.js",
  "files": [
    "build",
    "docs/dist"
  ],
  "scripts": {
    "build": "tsc && yarn docs:build",
    "build:ts": "tsc",
    "start": "tsc -w",
    "test": "vitest",
    "docs:dev": "astro dev --root docs --port 7301",
    "docs:build": "astro build --root docs",
    "docs:preview": "astro preview --root docs --port 7301"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beautifulbits/lib.git"
  },
  "keywords": [
    "shared",
    "library",
    "components",
    "code",
    "manager"
  ],
  "type": "module",
  "author": "Nathaniel Velez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/beautifulbits/lib/issues"
  },
  "homepage": "https://github.com/beautifulbits/lib#readme",
  "dependencies": {
    "boxen": "^7.1.1",
    "cli-table": "^0.3.11",
    "clipanion": "^4.0.0-rc.4",
    "consola": "^3.2.3",
    "diff": "^5.2.0",
    "enquirer": "^2.4.1",
    "fast-glob": "^3.3.2",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.30.0",
    "@types/cli-table": "^0.3.4",
    "@types/diff": "^5.2.3",
    "@types/node": "^22.13.4",
    "astro": "^5.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.0"
  }
}
